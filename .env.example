# whiteboard-server 의 REST API 베이스 URL.
WHITEBOARD_API_ORIGIN=http://localhost:8080

# 이 서버 전용 서비스 계정의 개인용 API 토큰(PAT). 필수 — 없으면 기동하지 않는다.
# 발급 방법은 README "인증 — 서비스 계정" 참고.
WHITEBOARD_SERVICE_TOKEN=wbpat_...

# 이 MCP 서버가 리슨할 포트.
PORT=3000

# 보드는 1회용이다 — 이만큼(분) 아무도 손대지 않으면 자동 삭제된다.
BOARD_TTL_MINUTES=60
# 정리 스윕 주기(분).
CLEANUP_INTERVAL_MINUTES=10
